# Публичный адрес панели (для ссылок-приглашений и deploy.sh)
PUBLIC_URL=http://localhost:8000

# Скопируйте в .env и заполните. Файл .env хранится только у вас на Mac.

# --- Цель ---
RACE_NAME=Ironman
RACE_DATE=2028-09-30

# --- Пороги (для оценки TSS, если источник его не дал) ---
FTP=200                 # Вт
LTHR=165                # пульс ПАНО
RUN_THRESHOLD_PACE=300  # сек/км (5:00)
SWIM_CSS=120            # сек/100 м (2:00)

# --- TrainingPeaks ---
# iCal: TrainingPeaks → Settings → Calendar Sync (iCal) → скопировать ссылку
TP_ICAL_URL=
# Веб-API: значение cookie Production_tpAuth из браузера после входа на app.trainingpeaks.com
TP_AUTH_COOKIE=

# --- Garmin Connect ---
# После заполнения один раз выполните: .venv/bin/python -m app.sync garmin-login
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Fitbit через Google Health API (инструкция в README) ---
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8000/api/fitbit/callback

# --- Синхронизация ---
SYNC_INTERVAL_MIN=60
SYNC_DAYS_BACK=30
SYNC_DAYS_FORWARD=21
